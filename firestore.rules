rules_version = '2';

// All writes go through the BLM API (Firebase Admin SDK). The browser only reads.
// Roles: the `admins` collection and the token `role` claim are written exclusively
// by the API; a user's own `users` document can never grant staff access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function role() {
      return request.auth.token.role is string
        ? request.auth.token.role
        : (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
            : 'customer');
    }

    function hasRole(roles) {
      return isSignedIn() && (role() in roles || role() == 'super_admin' || role() == 'admin');
    }

    function isOps() {
      return hasRole(['dispatcher', 'customer_support_agent', 'finance_admin']);
    }

    match /admins/{adminId} {
      allow read: if isOps() || isOwner(adminId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isOps();
      allow create: if isOwner(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.uid == userId;
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'verificationStatus', 'fraudFlags', 'paymentHistory']);
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isOps();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
    }

    match /hubs/{hubId} {
      allow read: if isSignedIn();
    }

    match /blocked_dates/{dateId} {
      allow read: if isSignedIn();
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isOps());
    }

    match /drivers/{driverId} {
      allow read: if isOps() || isOwner(driverId);
    }

    match /driver_locations/{driverId} {
      allow read: if isOps() || isOwner(driverId);
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || hasRole(['finance_admin', 'customer_support_agent']));
    }

    match /refunds/{refundId} {
      allow read: if hasRole(['finance_admin', 'customer_support_agent']);
    }

    match /ledger_entries/{entryId} {
      allow read: if hasRole(['finance_admin']);
    }

    match /audit_logs/{auditId} {
      allow read: if hasRole(['super_admin']);
    }

    match /booking_events/{eventId} {
      allow read: if isOps();
    }

    match /support_tickets/{ticketId} {
      allow read: if isOps() || resource.data.customerId == request.auth.uid;
    }

    match /notification_logs/{notificationId} {
      allow read: if isOps();
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read: if isOps();
    }

    match /reviews/{reviewId} {
      allow read: if isOps() || (isSignedIn() && resource.data.status == 'published');
    }
  }
}
