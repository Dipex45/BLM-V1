# ─── REQUIRED ON THE LIVE SITE ─────────────────────────────────────────────
# The server will not start in production without these.
NODE_ENV=production   # use "development" on your own computer
APP_URL="https://your-domain.com"
CORS_ORIGINS="https://your-domain.com"
# Paste the whole service-account JSON on ONE line. It must come from the SAME
# Firebase project the website signs users into (see firebase-applet-config.json).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Railway sets PORT automatically. For local development use 3000.
PORT=3000

# ─── FIREBASE WEB APP (optional) ───────────────────────────────────────────
# Leave empty to use firebase-applet-config.json. Set them all to switch projects.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# Only set this if the website and the server are on DIFFERENT addresses.
VITE_API_BASE_URL=

# ─── OPTIONAL FEATURES ─────────────────────────────────────────────────────
# Each one switches a feature on. If it is missing, that feature is simply hidden.

# Card payments (Stripe)
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack payments
PAYSTACK_SECRET_KEY=

# Road distance for ride and delivery prices (server) and the live map (browser)
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Emails (Resend)
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="BLM Motors <bookings@blmmotors.ng>"
SUPPORT_ALERT_EMAIL="bookings@blmmotors.ng"

# SMS and WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Background job queue. Without it, jobs run straight away inside the server.
REDIS_URL=

# Error tracking (Sentry)
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.15
LOG_LEVEL=info

# Search engine verification (paste the code each provider gives you)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
