# App
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"
PORT=3000
VITE_API_BASE_URL=

# Firebase Web SDK (public browser configuration; restrict the API key by domain)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID="(default)"

# Firebase Admin SDK
# Use one of these for server-side token verification and Firestore writes.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

# Redis / BullMQ
REDIS_URL=

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=

# Email Provider: Resend
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM="BLM Motors <bookings@blmmotors.ng>"
SUPPORT_ALERT_EMAIL="bookings@blmmotors.ng"

# SMS Provider: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Maps / route distance
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Observability
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.15
LOG_LEVEL=info

# Search engine ownership (paste provider-issued content values)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
