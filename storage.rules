rules_version = '2';

// Staff are recognised by the `role` custom claim, which only the BLM API sets.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return isSignedIn() && request.auth.token.role in ['admin', 'super_admin', 'dispatcher', 'finance_admin', 'customer_support_agent'];
    }

    function isImageUnderFiveMb() {
      return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isPaymentProofUnderFiveMb() {
      return request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
    }

    match /review-photos/{userId}/{fileName} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isImageUnderFiveMb();
    }

    match /payment-proofs/{userId}/{paymentId}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
      allow write: if isSignedIn() && request.auth.uid == userId && isPaymentProofUnderFiveMb();
    }

    match /car_hire/{fileName} {
      allow read: if true;
      allow write: if isStaff() && isImageUnderFiveMb();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
