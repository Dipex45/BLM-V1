{
  "rewrites": [
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/services/long-and-short-distance-trips", "destination": "/services/long-and-short-distance-trips/index.html" },
    { "source": "/services/cross-border-trips", "destination": "/services/cross-border-trips/index.html" },
    { "source": "/services/touring", "destination": "/services/touring/index.html" },
    { "source": "/services/car-hire", "destination": "/services/car-hire/index.html" },
    { "source": "/services/pickup-and-logistics", "destination": "/services/pickup-and-logistics/index.html" },
    { "source": "/corridors/lagos-cotonou", "destination": "/corridors/lagos-cotonou/index.html" },
    { "source": "/corridors/cotonou-lagos", "destination": "/corridors/cotonou-lagos/index.html" },
    { "source": "/corridors/lagos-lome", "destination": "/corridors/lagos-lome/index.html" },
    { "source": "/corridors/lagos-accra", "destination": "/corridors/lagos-accra/index.html" },
    { "source": "/legal", "destination": "/legal/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/brand/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
